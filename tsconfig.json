{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["packages", "apps/cli", "apps/server", "demos", "benchmarks", "scripts", "test"],
  "exclude": ["vendor", "apps/lab/public", "benchmarks/results", "**/fixtures/**"]
}
