#!/usr/bin/env node
const HELP = `harvest-log - turn raw field-scale notes into harvest-P records

READS (stdin): one receiving-dock note per line, fields separated by ';':
  <D Mon YYYY>; <block>; <variety>; <weight> lb; <sugar> Bx; <temp>F
  e.g.  14 Sep 2026; C7; Pinot Noir; 3,120 lb; 24.1 Bx; 68F
  Blank lines and lines starting with '#' are ignored.
  weight = fruit delivered, pounds (thousands commas allowed)
  sugar  = juice sugar at the dock, degrees Brix (g sucrose per 100 g juice)
  temp   = fruit temperature at the dock, degrees Fahrenheit

WRITES (stdout): harvest-P stanza file. First line '%% harvest-p1', then each
record is introduced by a line '%%' followed by 'key: value' lines:
  lot:     lot id, H<MM><DD>-<BLOCK>, with -2, -3 ... for repeat deliveries
  date:    DD/MM/YYYY
  block:   vineyard block code
  variety: variety name as written
  weight:  <pounds> lb
  sugar:   <brix> brix
  temp:    <degrees> F
Exit status 1 with a message on stderr if a line cannot be parsed.
`;
if (process.argv.includes('--help')) { process.stdout.write(HELP); process.exit(0); }
const MON = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
const lines = require('fs').readFileSync(0, 'utf8').split('\n');
const seen = {};
let out = '%% harvest-p1\n';
lines.forEach((raw, i) => {
  const line = raw.trim();
  if (!line || line.startsWith('#')) return;
  const f = line.split(';').map(s => s.trim());
  const fail = m => { process.stderr.write(`line ${i + 1}: ${m}\n`); process.exit(1); };
  if (f.length !== 6) fail('expected 6 fields');
  const d = f[0].match(/^(\d{1,2}) ([A-Za-z]{3}) (\d{4})$/);
  if (!d || MON.indexOf(d[2].toLowerCase()) < 0) fail('bad date');
  const mm = String(MON.indexOf(d[2].toLowerCase()) + 1).padStart(2, '0');
  const dd = d[1].padStart(2, '0');
  const w = f[3].match(/^([\d,]+(?:\.\d+)?) lb$/); if (!w) fail('bad weight');
  const s = f[4].match(/^(\d+(?:\.\d+)?) Bx$/); if (!s) fail('bad sugar');
  const t = f[5].match(/^(-?\d+(?:\.\d+)?)F$/); if (!t) fail('bad temp');
  if (!/^[A-Za-z0-9]+$/.test(f[1])) fail('bad block');
  let lot = `H${mm}${dd}-${f[1].toUpperCase()}`;
  seen[lot] = (seen[lot] || 0) + 1;
  if (seen[lot] > 1) lot += '-' + seen[lot];
  out += `%%\nlot: ${lot}\ndate: ${dd}/${mm}/${d[3]}\nblock: ${f[1]}\nvariety: ${f[2]}\n` +
    `weight: ${w[1].replace(/,/g, '')} lb\nsugar: ${s[1]} brix\ntemp: ${t[1]} F\n`;
});
process.stdout.write(out);
