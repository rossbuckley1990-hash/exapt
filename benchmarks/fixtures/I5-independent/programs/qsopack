#!/usr/bin/env node
const HELP = `qsopack - pack a raw station logbook into QSOPACK v1 (format P)

READS (stdin): one contact per line, whitespace separated:
  DATE TIME CALL MHZ MODE RST_SENT RST_RCVD WATTS NAME...
  DATE   YYYY-MM-DD, UTC
  TIME   HH:MM, UTC
  CALL   callsign
  MHZ    frequency in megahertz, e.g. 14.250
  MODE   SSB, CW, FM, AM or RTTY
  WATTS  transmit power in watts (whole number)
  NAME   operator name, rest of the line
  Blank lines and lines starting with # are ignored.

WRITES (stdout):
  #QSOPACK 1
  QSO <call> <year>:<day-of-year> <sec> <khz> <mode> <rs> <rr> <dbm> <name...>
  END <count>
  year:day-of-year  UTC date, day of year 001-366
  sec               seconds since 00:00 UTC, 0-86399
  khz               frequency in whole kilohertz
  dbm               transmit power in dBm, two decimals (0 dBm = 1 mW)
Exits 1 with a message on stderr for any malformed line.
`;
if (process.argv.includes('--help')) { process.stdout.write(HELP); process.exit(0); }
const lines = require('fs').readFileSync(0, 'utf8').split('\n');
const out = ['#QSOPACK 1'];
let n = 0;
lines.forEach((ln, i) => {
  ln = ln.trim();
  if (!ln || ln.startsWith('#')) return;
  const f = ln.split(/\s+/);
  const bad = (m) => { console.error(`line ${i + 1}: ${m}`); process.exit(1); };
  if (f.length < 9) bad('too few fields');
  const [d, t, call, mhz, mode, rs, rr, w] = f;
  const name = f.slice(8).join(' ');
  const dm = /^(\d{4})-(\d\d)-(\d\d)$/.exec(d), tm = /^(\d\d):(\d\d)$/.exec(t);
  if (!dm) bad('bad date'); if (!tm) bad('bad time');
  const y = +dm[1];
  const doy = Math.round((Date.UTC(y, +dm[2] - 1, +dm[3]) - Date.UTC(y, 0, 1)) / 864e5) + 1;
  const sec = +tm[1] * 3600 + +tm[2] * 60;
  const khz = Math.round(parseFloat(mhz) * 1000);
  if (!(khz > 0)) bad('bad frequency');
  const watts = parseInt(w, 10);
  if (!(watts > 0)) bad('bad power');
  const dbm = (10 * Math.log10(watts * 1000)).toFixed(2);
  out.push(`QSO ${call.toUpperCase()} ${y}:${String(doy).padStart(3, '0')} ${sec} ${khz} ${mode.toUpperCase()} ${rs} ${rr} ${dbm} ${name}`);
  n++;
});
out.push(`END ${n}`);
process.stdout.write(out.join('\n') + '\n');
