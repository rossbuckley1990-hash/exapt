#!/usr/bin/env node

const fs = require('fs');
const args = process.argv.slice(2);
const read = () => fs.readFileSync(0, 'utf8');
const lines = (t) => t.split(/\r?\n/).filter((l) => l.trim() !== '');
const fail = (m) => { process.stderr.write(m + '\n'); process.exit(3); };

const HELP = "usage: dock-archive\n\nWrites readings back out in the legacy site table for long-term storage.\nReads the same newline-delimited JSON as dock-ingest from standard input.\n\nExample input:\n  {\"origin\":\"rig-1a\",\"epoch_s\":1772619300,\"norm_value\":103.0,\"area\":\"North-Wing\"}\n";
if (args.includes('--help') || args.includes('-h')) { process.stdout.write(HELP); process.exit(0); }
if (args.includes('--version')) { process.stdout.write("dock-archive 0.9.4" + '\n'); process.exit(0); }

const out = [["tag", "reading_time", "level", "site_label"].join(";")];
for (const [i, l] of lines(read()).entries()) {
  let r;
  try { r = JSON.parse(l); } catch { fail('line ' + (i + 1) + ': not a JSON object'); }
  const v = r["norm_value"], ts = r["epoch_s"];
  if (typeof v !== 'number' || !Number.isInteger(ts) || !("origin" in r) || !("area" in r)) fail('line ' + (i + 1) + ': incomplete reading');
  out.push([r["origin"], new Date(ts * 1000).toISOString().replace('.000Z', 'Z'), (v * 0.01 + 0).toFixed(2), r["area"]].join(";"));
}
process.stdout.write(out.join('\n') + '\n');

