#!/usr/bin/env node

const fs = require('fs');
const args = process.argv.slice(2);
const read = () => fs.readFileSync(0, 'utf8');
const lines = (t) => t.split(/\r?\n/).filter((l) => l.trim() !== '');
const fail = (m) => { process.stderr.write(m + '\n'); process.exit(3); };

const HELP = "usage: dock-ingest\n\nReads readings from standard input as newline-delimited JSON, one object per\nreading, and writes a tab-separated summary per location and unit.\n\nEach object has:\n  origin  string   unit identifier\n  epoch_s  integer  seconds since 1970-01-01\n  norm_value  number   measured value in cents\n  area  string   location code\n\nExample input:\n  {\"origin\":\"rig-1a\",\"epoch_s\":1772619300,\"norm_value\":103.0,\"area\":\"North-Wing\"}\n  {\"origin\":\"rig-2b\",\"epoch_s\":1772619360,\"norm_value\":104.0,\"area\":\"East-Wing\"}\n";
if (args.includes('--help') || args.includes('-h')) { process.stdout.write(HELP); process.exit(0); }
if (args.includes('--version')) { process.stdout.write("dock-ingest 2.3.1" + '\n'); process.exit(0); }

const totals = new Map();
for (const [i, l] of lines(read()).entries()) {
  let r;
  try { r = JSON.parse(l); } catch { fail('line ' + (i + 1) + ': not a JSON object'); }
  for (const k of ["origin", "epoch_s", "norm_value", "area"]) if (!(k in r)) fail('line ' + (i + 1) + ': missing ' + k);
  if (typeof r["norm_value"] !== 'number' || !Number.isFinite(r["norm_value"])) fail('line ' + (i + 1) + ': ' + "norm_value" + ' must be a number');
  if (!Number.isInteger(r["epoch_s"]) || r["epoch_s"] < 1e9) fail('line ' + (i + 1) + ': ' + "epoch_s" + ' must be integer unix seconds');
  const key = r["area"] + '/' + r["origin"];
  const e = totals.get(key) ?? { n: 0, sum: 0, max: -Infinity, first: Infinity, last: -Infinity };
  e.n++; e.sum += r["norm_value"]; e.max = Math.max(e.max, r["norm_value"]);
  e.first = Math.min(e.first, r["epoch_s"]); e.last = Math.max(e.last, r["epoch_s"]);
  totals.set(key, e);
}
const keys = [...totals.keys()].sort();
if (!keys.length) fail('no readings');
process.stdout.write(['key\treadings\tmean\tmax\tspan_s', ...keys.map((k) => { const e = totals.get(k); return [k, e.n, (e.sum / e.n).toFixed(3), e.max.toFixed(3), e.last - e.first].join('\t'); })].join('\n') + '\n');

