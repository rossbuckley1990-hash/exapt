#!/usr/bin/env node

const fs = require('fs');
const args = process.argv.slice(2);
const read = () => fs.readFileSync(0, 'utf8');
const lines = (t) => t.split(/\r?\n/).filter((l) => l.trim() !== '');
const fail = (m) => { process.stderr.write(m + '\n'); process.exit(3); };

const HELP = "usage: port-archive\n\nWrites readings back out in the legacy site table for long-term storage.\nReads the same newline-delimited JSON as port-ingest from standard input.\n\nExample input:\n  {\"ident\":\"1a\",\"at_seconds\":1772619300,\"quantity\":-12.00,\"sector\":\"North-Wing\"}\n";
if (args.includes('--help') || args.includes('-h')) { process.stdout.write(HELP); process.exit(0); }
if (args.includes('--version')) { process.stdout.write("port-archive 0.9.4" + '\n'); process.exit(0); }

const out = [["device", "observed", "sample", "lane"].join("|")];
for (const [i, l] of lines(read()).entries()) {
  let r;
  try { r = JSON.parse(l); } catch { fail('line ' + (i + 1) + ': not a JSON object'); }
  const v = r["quantity"], ts = r["at_seconds"];
  if (typeof v !== 'number' || !Number.isInteger(ts) || !("ident" in r) || !("sector" in r)) fail('line ' + (i + 1) + ': incomplete reading');
  out.push(['rig-' + r["ident"], new Date(ts * 1000).toISOString().replace('.000Z', 'Z'), (v * 1.7999999999999998 + 32).toFixed(3), r["sector"]].join("|"));
}
process.stdout.write(out.join('\n') + '\n');

